# EduNova environment example
# Copy this file to .env for local development. Do not commit real .env files.

APP_NAME=EduNova
APP_ENV=development
APP_DEBUG=true

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# FRONTEND_PORT is used by the Vite dev server. Docker preview uses NGINX_PORT.
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
NGINX_PORT=8080

DATABASE_URL=postgresql+psycopg://edunova:edunova_dev_password@localhost:5432/edunova
REDIS_URL=redis://localhost:6379/0

POSTGRES_DB=edunova
POSTGRES_USER=edunova
POSTGRES_PASSWORD=edunova_dev_password
POSTGRES_PORT=5432
REDIS_PORT=6379

JWT_SECRET=change-this-local-development-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

DEMO_MODE=true
DEMO_ACCOUNT_EMAIL=demo@edunova.local
DEMO_ACCOUNT_PASSWORD=Demo123456

SYSTEM_MODEL_PROVIDER=openai_compatible
SYSTEM_MODEL_BASE_URL=https://api.example.com/v1
SYSTEM_MODEL_API_KEY=replace-with-your-own-key
SYSTEM_CHAT_MODEL=example-chat-model
SYSTEM_EMBEDDING_MODEL=example-embedding-model

UPLOAD_DIR=storage/uploads
MATERIAL_STORAGE_DIR=var/uploads/materials
MATERIAL_MAX_UPLOAD_MB=25
EXPORT_DIR=storage/exports
LOG_LEVEL=INFO
