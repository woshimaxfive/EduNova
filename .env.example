# EduNova environment example
# Copy this file to .env for local development. Do not commit real .env files.

APP_NAME=EduNova
APP_ENV=development
APP_DEBUG=true

# Optional build mirrors. Keep official defaults for reproducible public builds;
# mainland China developers may use the alternatives documented in DEPLOYMENT.md.
PIP_INDEX_URL=https://pypi.org/simple
HF_ENDPOINT=https://huggingface.co
NPM_REGISTRY=https://registry.npmjs.org
DEBIAN_MIRROR=http://deb.debian.org/debian
DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
TORCH_VERSION=2.13.0+cpu
TORCHVISION_VERSION=0.28.0+cpu

BACKEND_PORT=8000
NGINX_PORT=8080

DATABASE_URL=postgresql+psycopg://edunova:change-this-local-database-password@localhost:5432/edunova
REDIS_URL=redis://localhost:6379/0
EXPORT_QUEUE_NAME=edunova_exports
AI_JOB_QUEUE_NAME=edunova_ai
AI_JOB_TIMEOUT_SECONDS=900
AI_JOB_STALE_SECONDS=180
AI_JOB_MAX_ACTIVE_PER_USER=2
CODE_VERIFIER_TIMEOUT_SECONDS=40
CODE_VERIFIER_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=edunova-api

POSTGRES_DB=edunova
POSTGRES_USER=edunova
POSTGRES_PASSWORD=change-this-local-database-password
POSTGRES_PORT=5432
REDIS_PORT=6379

JWT_SECRET=change-this-local-development-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

SYSTEM_MODEL_PROVIDER=openai_compatible
SYSTEM_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SYSTEM_MODEL_API_KEY=replace-with-your-bailian-api-key
SYSTEM_CHAT_MODEL=qwen3.8-flash
# Server-managed fallback for resources, paths, practice and reports. Personal
# answer-model settings override this connection for that user.
SYSTEM_GENERATION_PROVIDER=openai_compatible
SYSTEM_GENERATION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SYSTEM_GENERATION_API_KEY=replace-with-your-bailian-api-key
SYSTEM_GENERATION_MODEL=qwen3.8-flash
# 本地向量与关键词融合排序，无需外部向量或重排序Key。
SYSTEM_EMBEDDING_PROVIDER=fastembed_local
LOCAL_EMBEDDING_MODEL_DIR=storage/models/bge-small-zh-v1.5
LOCAL_EMBEDDING_THREADS=2
# Image understanding uses the effective main model and its credentials.
# Enable image input by running the image capability test in Settings.

# Local ASR starts with Compose; read aloud uses local browser voices. No speech Key.
SPEECH_REQUEST_TIMEOUT_SECONDS=75
SPEECH_MAX_AUDIO_SECONDS=60
VISION_REQUEST_TIMEOUT_SECONDS=60
MODEL_SETTINGS_ENCRYPTION_KEY=replace-with-fernet-key
MODEL_REQUEST_TIMEOUT_SECONDS=45
MODEL_MAX_ATTEMPTS=3
MODEL_RETRY_BASE_DELAY_SECONDS=0.5
MODEL_RETRY_MAX_DELAY_SECONDS=2
MODEL_RETRY_AFTER_MAX_SECONDS=3
MODEL_CIRCUIT_FAILURE_THRESHOLD=5
MODEL_CIRCUIT_WINDOW_SECONDS=60
MODEL_CIRCUIT_OPEN_SECONDS=60
MODEL_MAX_CONCURRENT_PER_USER=3
MODEL_MAX_CONCURRENT_GLOBAL=12
MODEL_CONCURRENCY_WAIT_SECONDS=2
MODEL_CALL_LOG_RETENTION_DAYS=30
# 自定义兼容服务确认支持流式用量后才开启；缺少 usage 仍记为未知。
MODEL_STREAM_USAGE_ENABLED=false
# 可选明确报价，键为 provider_source:配置ID或system:模型名。默认不估算费用。
MODEL_USAGE_PRICING={}
# 问答上下文估算预算；只控制输入内容组织，不等于供应商精确 token 或账单上限。
TUTOR_CONTEXT_WINDOW_TOKENS=16384
TUTOR_OUTPUT_RESERVE_TOKENS=4096
# 历史经历召回的余弦相似度门槛；按实际嵌入模型和课程样本校准。
CONVERSATION_MEMORY_MIN_SIMILARITY=0.72

# SearXNG starts with Docker Compose; no external search API key is needed.
# initialize_env.ps1 generates its private signing secret automatically.
SEARXNG_SECRET=
WEB_SEARCH_MAX_RESULTS=5

MATERIAL_STORAGE_DIR=var/uploads/materials
CHAT_ATTACHMENT_STORAGE_DIR=var/uploads/chat-attachments
EDUNOVA_DOCUMENT_PARSER=docling
DOCLING_ARTIFACTS_PATH=var/models/docling
DOCLING_DOCUMENT_TIMEOUT_SECONDS=120
MATERIAL_MAX_UPLOAD_MB=25
EXPORT_DIR=storage/exports
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10
