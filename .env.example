# EduNova environment example
# Copy this file to .env for local development. Do not commit real .env files.

APP_NAME=EduNova
APP_ENV=development
APP_DEBUG=true

# Optional build mirrors. Keep official defaults for reproducible public builds;
# mainland China developers may use the alternatives documented in DEPLOYMENT.md.
PIP_INDEX_URL=https://pypi.org/simple
HF_ENDPOINT=https://huggingface.co
NPM_REGISTRY=https://registry.npmjs.org
DEBIAN_MIRROR=http://deb.debian.org/debian
DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
TORCH_VERSION=2.13.0+cpu
TORCHVISION_VERSION=0.28.0+cpu

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# FRONTEND_PORT is used by the Vite dev server. Docker preview uses NGINX_PORT.
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
NGINX_PORT=8080

DATABASE_URL=postgresql+psycopg://edunova:edunova_dev_password@localhost:5432/edunova
REDIS_URL=redis://localhost:6379/0
EXPORT_QUEUE_NAME=edunova_exports
AI_JOB_QUEUE_NAME=edunova_ai
AI_JOB_TIMEOUT_SECONDS=900
AI_JOB_STALE_SECONDS=180
AI_JOB_MAX_ACTIVE_PER_USER=2
CODE_VERIFIER_TIMEOUT_SECONDS=40
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=edunova-api

POSTGRES_DB=edunova
POSTGRES_USER=edunova
POSTGRES_PASSWORD=edunova_dev_password
POSTGRES_PORT=5432
REDIS_PORT=6379

JWT_SECRET=change-this-local-development-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

SYSTEM_MODEL_PROVIDER=openai_compatible
SYSTEM_MODEL_BASE_URL=https://spark-api-open.xf-yun.com/agent/v1/
SYSTEM_MODEL_API_KEY=replace-with-your-xfyun-api-password
SYSTEM_CHAT_MODEL=spark-x
# Optional independent embedding connection. Leave the model empty to keep vector retrieval disabled.
SYSTEM_EMBEDDING_PROVIDER=
SYSTEM_EMBEDDING_BASE_URL=
SYSTEM_EMBEDDING_API_KEY=
SYSTEM_EMBEDDING_APP_ID=
SYSTEM_EMBEDDING_API_SECRET=
SYSTEM_EMBEDDING_MODEL=
SYSTEM_EMBEDDING_DIMENSION=
SYSTEM_RERANK_PROVIDER=
SYSTEM_RERANK_BASE_URL=
SYSTEM_RERANK_API_KEY=
SYSTEM_RERANK_MODEL=
SYSTEM_RERANK_WORKSPACE_ID=
MODEL_SETTINGS_ENCRYPTION_KEY=replace-with-fernet-key
MODEL_REQUEST_TIMEOUT_SECONDS=20
MODEL_MAX_ATTEMPTS=3
MODEL_RETRY_BASE_DELAY_SECONDS=0.5
MODEL_RETRY_MAX_DELAY_SECONDS=2
MODEL_RETRY_AFTER_MAX_SECONDS=3
MODEL_CIRCUIT_FAILURE_THRESHOLD=5
MODEL_CIRCUIT_WINDOW_SECONDS=60
MODEL_CIRCUIT_OPEN_SECONDS=60
MODEL_MAX_CONCURRENT_PER_USER=3
MODEL_MAX_CONCURRENT_GLOBAL=12
MODEL_CONCURRENCY_WAIT_SECONDS=2
MODEL_CALL_LOG_RETENTION_DAYS=30

WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_ENDPOINT=https://api.tavily.com/search
# Leave empty to disable web search honestly. Do not commit a real key.
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5

UPLOAD_DIR=storage/uploads
MATERIAL_STORAGE_DIR=var/uploads/materials
CHAT_ATTACHMENT_STORAGE_DIR=var/uploads/chat-attachments
EDUNOVA_DOCUMENT_PARSER=docling
DOCLING_ARTIFACTS_PATH=var/models/docling
DOCLING_DOCUMENT_TIMEOUT_SECONDS=120
MATERIAL_MAX_UPLOAD_MB=25
EXPORT_DIR=storage/exports
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
